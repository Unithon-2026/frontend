diff --git a/src/main/java/com/unithon/meetroute/domain/priority/entity/PriorityGrade.java b/src/main/java/com/unithon/meetroute/domain/priority/entity/PriorityGrade.java
index 59707bf..0f1a835 100644
--- a/src/main/java/com/unithon/meetroute/domain/priority/entity/PriorityGrade.java
+++ b/src/main/java/com/unithon/meetroute/domain/priority/entity/PriorityGrade.java
@@ -1,5 +1,49 @@
 package com.unithon.meetroute.domain.priority.entity;
 
+import com.fasterxml.jackson.annotation.JsonCreator;
+import com.fasterxml.jackson.annotation.JsonValue;
+
+/**
+ * 영업 우선순위 등급. 1등급이 가장 높고 4등급이 가장 낮다.
+ *
+ * <p>enum 상수는 숫자로 시작할 수 없어 G1~G4로 두고, JSON 직렬화·역직렬화와
+ * 쿼리 파라미터에서는 {@code "1"}~{@code "4"} 를 그대로 쓴다.
+ * DB(EnumType.STRING)에는 상수명 G1~G4가 저장된다.
+ */
 public enum PriorityGrade {
-    S, A, B, C
+
+    G1("1"),
+    G2("2"),
+    G3("3"),
+    G4("4");
+
+    private final String value;
+
+    PriorityGrade(String value) {
+        this.value = value;
+    }
+
+    @JsonValue
+    public String getValue() {
+        return value;
+    }
+
+    /**
+     * {@code "1"}~{@code "4"} 와 {@code "G1"}~{@code "G4"} 를 모두 받는다.
+     *
+     * @return 매칭되는 등급, 없으면 {@code null}
+     */
+    @JsonCreator
+    public static PriorityGrade from(String raw) {
+        if (raw == null || raw.isBlank()) {
+            return null;
+        }
+        String normalized = raw.trim().toUpperCase();
+        for (PriorityGrade grade : values()) {
+            if (grade.value.equals(normalized) || grade.name().equals(normalized)) {
+                return grade;
+            }
+        }
+        return null;
+    }
 }
