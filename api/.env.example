# ── MeatLead 환경변수 예시 ──
# 실제 값은 커밋하지 말고 .env 로 복사해서 사용하세요.

# ────────────────────────────────────────────────────────────────
# 프론트엔드
# ────────────────────────────────────────────────────────────────

# 백엔드 주소. Spring Boot 기본 포트 8080, context-path 없음.
# 엔드포인트는 이 값 뒤에 /api/v1/... 이 붙습니다.
API_BASE_URL=http://localhost:8080

# 번들러를 쓰면 접두사가 필요합니다. 쓰는 것 하나만 남기세요.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# VITE_API_BASE_URL=http://localhost:8080
# REACT_APP_API_BASE_URL=http://localhost:8080

# prototype/index.html 은 빌드가 없어 .env 를 읽지 못합니다.
# 기본값 http://localhost:8080 을 쓰며, 바꾸려면 브라우저 콘솔에서:
#   localStorage.setItem('meatlead.apiBase', 'http://192.168.0.10:8080')

# ────────────────────────────────────────────────────────────────
# 백엔드 (unithon-2026/backend) — 참고용
# ────────────────────────────────────────────────────────────────
# 아래는 백엔드 저장소의 application.yaml 이 실제로 요구하는 변수입니다.
# 이 저장소에서 쓰이지는 않지만, 로컬에서 백엔드를 띄울 때 필요합니다.
#
#   DB_URL=jdbc:mysql://localhost:3306/meetroute
#   DB_USER=root
#   DB_PASSWORD=
#
# ⚠️ MySQL 입니다. 기존 초안에 적혀 있던 PostgreSQL DATABASE_URL 은 실제와 다릅니다.
# ⚠️ JWT_SECRET / JWT_EXPIRES_IN 도 제거했습니다 — 현재 SecurityConfig 는 전체 permitAll 이라
#    인증이 없고, 토큰 발급 코드도 없습니다.

# ────────────────────────────────────────────────────────────────
# 아직 쓰이지 않는 값 (미구현 기능용)
# ────────────────────────────────────────────────────────────────
# 데이터 수집 스케줄러·지오코딩·AI 브리핑은 서버에 구현되어 있지 않습니다.
# 해당 기능을 붙일 때 백엔드 쪽 환경변수로 추가하세요.
#
#   PUBLIC_DATA_API_KEY=    # 서울시 위생업소 인허가 OpenAPI
#   MAP_API_KEY=            # 지도·지오코딩 (좌표 변환)
#   AI_API_KEY=             # AI 브리핑 (ErrorCode 에 SHOP5001 만 선점되어 있음)
#   COLLECT_RETRY_MAX=3     # 수집 실패 시 자동 재시도 횟수

# ────────────────────────────────────────────────────────────────
# CORS
# ────────────────────────────────────────────────────────────────
# ⚠️ 백엔드 SecurityConfig 에 CORS 설정이 없습니다.
# 프로토타입을 file:// 이나 다른 포트에서 열면 브라우저가 요청을 막습니다.
# 백엔드에 CORS 허용을 추가해야 합니다 — 백엔드 담당자 협의 대상.
CORS_ORIGIN=http://localhost:3000
